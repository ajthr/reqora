{
  "name": "reqora",
  "version": "0.1.0",
  "private": true,
  "description": "A free, open-source REST client for web and desktop.",
  "author": "Ajith",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/start.ts",
    "start:api": "node server/start.ts",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json && tsc --project tsconfig.electron.json --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "build:desktop": "tsc --project tsconfig.electron.json",
    "build": "npm run build:web && npm run build:desktop",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "package": "node scripts/package.mjs",
    "package:desktop": "npm run package -- --mode desktop",
    "package:web": "npm run package -- --mode web",
    "package:all": "npm run package -- --mode both",
    "test:packages": "node scripts/smoke-install.mjs",
    "cli": "node cli/reqora.mjs"
  },
  "dependencies": {
    "@smithy/hash-node": "4.5.2",
    "@smithy/signature-v4": "5.7.4",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "bin": {
    "reqora": "cli/reqora.mjs"
  }
}
